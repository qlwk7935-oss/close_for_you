<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Keep bundled OCR local even if a transitive SDK declares network access. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <!-- BIND_ACCESSIBILITY_SERVICE belongs on the service, not uses-permission. -->
    <!-- C TODO: request RECORD_AUDIO only with the future push-to-talk UI. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- C "도와줄 앱": launcher apps only (Android 11+ package visibility). Not QUERY_ALL_PACKAGES. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ui_ic_launcher"
        android:roundIcon="@mipmap/ui_ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CloseForYou">

        <activity
            android:name="kr.closeforyou.app.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name="kr.closeforyou.accessibility.CloseForYouAccessibilityService"
            android:exported="true"
            android:label="@string/core_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
        <!-- C(simpleclose): plan-B simple close engine (AGENTS 6-0 demo mode), the app's engine on
             integration/popup-helper. Turn on this OR A's "닫아줄게" above, never both. Reads the active app's
             tree, classifies with B, clicks one verified close button or asks through C's prompt.
             No gestures, no screenshots, no screen text in logs. -->
        <service
            android:name="kr.closeforyou.simpleclose.SimpleCloseAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/ui_simple_close_service" />
        </service>
    </application>
</manifest>
