<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission
        android:name="kr.closeforyou.permission.SYNTHETIC_CAPTURE_TEST"
        android:protectionLevel="signature" />
    <!-- C(ui/voice) debug only: push-to-talk voice command test on the preview screen (on-device recognizer). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <application>
        <!-- Only debug builds. No image/text IPC, no service activation or arbitrary app selection. -->
        <provider
            android:name="kr.closeforyou.accessibility.testing.SyntheticCaptureTestProvider"
            android:authorities="${applicationId}.syntheticcapturetest"
            android:exported="true"
            android:permission="kr.closeforyou.permission.SYNTHETIC_CAPTURE_TEST" />
        <!-- C(ui/voice): debug-only "닫을까요?" prompt preview with synthetic fixtures. No real screen data or actions. -->
        <activity
            android:name="kr.closeforyou.ui.voice.debug.ChoicePreviewActivity"
            android:exported="true"
            android:label="@string/ui_debug_preview_label"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- C(ui/voice): debug-only test service that shows the real "닫을까요?" overlay above other apps.
             Receives only this app's events and performs no actions. canRetrieveWindowContent=true only for the
             issue #29 diagnosis (adb extra), which logs window ids/types/layers, never screen text. -->
        <service
            android:name="kr.closeforyou.ui.voice.debug.ChoiceOverlayTestService"
            android:exported="true"
            android:label="@string/ui_debug_overlay_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/ui_voice_overlay_test_service" />
        </service>
    </application>
</manifest>
