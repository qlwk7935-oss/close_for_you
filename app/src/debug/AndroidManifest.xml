<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission
        android:name="kr.closeforyou.permission.SYNTHETIC_CAPTURE_TEST"
        android:protectionLevel="signature" />
    <!-- C(ui/voice) debug only: push-to-talk voice command test on the preview screen (on-device recognizer). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- C(ui/voice) "도와줄 앱": launcher apps only (Android 11+ package visibility). Not QUERY_ALL_PACKAGES.
         Debug only until A adds the same <queries> to the main manifest (docs/c-notes/app-picker.md). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application>
        <!-- A opt-in reader experiment. No executor, gestures, screenshots, or automatic run.
             Enable manually only on a dedicated synthetic-test emulator; disable A production service. -->
        <service android:name="kr.closeforyou.accessibility.testing.P01ReaderComparisonService"
            android:exported="true" android:label="@string/a_p01_reader_test_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/a_p01_reader_test_service" />
        </service>
        <!-- Only debug builds. No image/text IPC, no service activation or arbitrary app selection. -->
        <provider
            android:name="kr.closeforyou.accessibility.testing.SyntheticCaptureTestProvider"
            android:authorities="${applicationId}.syntheticcapturetest"
            android:exported="true"
            android:permission="kr.closeforyou.permission.SYNTHETIC_CAPTURE_TEST" />
        <!-- C(ui/voice): debug-only "닫을까요?" prompt preview with synthetic fixtures. No real screen data or actions. -->
        <activity
            android:name="kr.closeforyou.ui.voice.debug.ChoicePreviewActivity"
            android:exported="true"
            android:label="@string/ui_debug_preview_label"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- C(ui/voice): debug-only test service that shows the real "닫을까요?" overlay above other apps.
             Receives only this app's events and performs no actions. canRetrieveWindowContent=true only for the
             issue #29 diagnosis (adb extra), which logs run-local window numbers/types/layers, never raw ids or screen text. -->
        <service
            android:name="kr.closeforyou.ui.voice.debug.ChoiceOverlayTestService"
            android:exported="true"
            android:label="@string/ui_debug_overlay_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/ui_voice_overlay_test_service" />
        </service>
    </application>
</manifest>
