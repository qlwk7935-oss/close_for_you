<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission
        android:name="kr.closeforyou.permission.SYNTHETIC_CAPTURE_TEST"
        android:protectionLevel="signature" />
    <application>
        <!-- Only debug builds. No image/text IPC, no service activation or arbitrary app selection. -->
        <provider
            android:name="kr.closeforyou.accessibility.testing.SyntheticCaptureTestProvider"
            android:authorities="${applicationId}.syntheticcapturetest"
            android:exported="true"
            android:permission="kr.closeforyou.permission.SYNTHETIC_CAPTURE_TEST" />
        <!-- C(ui/voice): debug-only "닫을까요?" prompt preview with synthetic fixtures. No real screen data or actions. -->
        <activity
            android:name="kr.closeforyou.ui.voice.debug.ChoicePreviewActivity"
            android:exported="true"
            android:label="@string/ui_debug_preview_label">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
