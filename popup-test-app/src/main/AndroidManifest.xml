<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- D: debug/testOnly 합성 팝업 재현 앱. 네트워크·저장소·실제 권한을 요청하지 않는다. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:testOnly="true"
        android:icon="@android:drawable/ic_menu_gallery"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light">
        <activity
            android:name=".ScenarioListActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- adb로 직접 열기: am start -n kr.closeforyou.popuptest/.PopupScenarioActivity 에 문자열 extra scenario=P04 -->
        <activity
            android:name=".PopupScenarioActivity"
            android:exported="true" />
        <activity
            android:name=".AdLandingActivity"
            android:exported="false" />
    </application>
</manifest>
